# ============================================
# COURTSIDE — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git (it's already in .gitignore by default).
#
# Where to find each value:
# - Supabase: Dashboard → Settings → API
# - Clerk: Dashboard → API Keys
# - Tennis API: Account dashboard after signup
# ============================================

# ─── Supabase ───
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Dashboard → Settings → API → anon/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dashboard → Settings → API → service_role key (KEEP SECRET — server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Clerk ───
# Dashboard → API Keys → Publishable key (safe for client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Dashboard → API Keys → Secret key (KEEP SECRET — server-side only)
CLERK_SECRET_KEY=sk_live_...

# Dashboard → Webhooks → Signing secret (for Clerk → Supabase profile sync)
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Tennis Data API ───
# Your API key from whichever tennis data provider you choose
# (api-tennis.com, RapidAPI, etc.)
TENNIS_API_KEY=your_api_key_here

# If using RapidAPI, you may also need:
# TENNIS_API_HOST=tennis-api-atp-wta-itf.p.rapidapi.com
